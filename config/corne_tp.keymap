/*
 * Corne Trackpoint Keymap
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

/*
 * The TrackPoint driver's runtime-tuning behaviors (&mms, from
 * behaviors/mouse_setting.dtsi) are intentionally NOT included: behaviors
 * run on the central (left half), which has no PS/2 device, so they would do
 * nothing (and are not built there). Tune the TrackPoint via the tp-*
 * properties in boards/shields/corne_tp/corne_tp_right.overlay instead.
 */

// Layer definitions
#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define ADJUST  3
#define SCROLL  4

/ {
    behaviors {
        // Tap: middle click. Hold: TrackPoint scrolls (activates SCROLL layer).
        mclk_scroll: mclk_scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp TAB   &kp Q &kp W &kp E &kp R &kp T     &kp Y &kp U &kp I     &kp O   &kp P    &kp BSPC
                &kp LCTRL &kp A &kp S &kp D &kp F &kp G     &kp H &kp J &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B     &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp ESC
                              &kp LGUI &mo LOWER &kp SPACE     &kp RET &mo RAISE &kp RALT
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
                &kp TAB   &kp N1    &kp N2    &kp N3    &kp N4 &kp N5     &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
                &kp LCTRL &mkp LCLK &mclk_scroll SCROLL MCLK &mkp RCLK &trans &trans     &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
                &kp LSHFT &trans    &trans    &trans    &trans &trans     &trans   &trans   &trans &trans    &trans &trans
                                    &kp LGUI &trans &kp SPACE     &kp RET &mo ADJUST &kp RALT
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
                &kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT     &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
                &kp LCTRL &trans   &trans &trans   &trans   &trans        &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
                &kp LSHFT &trans   &trans &trans   &trans   &trans        &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                                      &kp LGUI &mo ADJUST &kp SPACE     &kp RET &trans &kp RALT
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4     &trans &trans &trans &trans &trans &trans
                &trans     &trans       &trans       &trans       &trans       &trans           &trans &trans &trans &trans &trans &trans
                &trans     &trans       &trans       &trans       &trans       &trans           &trans &trans &trans &trans &trans &trans
                                                         &trans &trans &trans     &trans &trans &trans
            >;
        };

        // Active while the middle-click key is held: TrackPoint movement scrolls.
        scroll_layer {
            display-name = "Scroll";
            bindings = <
                &trans &trans &trans &trans &trans &trans     &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans     &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans     &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans     &trans &trans &trans
            >;
        };
    };
};

/*
 * While SCROLL is active, TrackPoint X/Y become horizontal/vertical scroll.
 * The listener lives on the central (left half); see corne_tp.dtsi.
 * Speed: raise the divisor in `zip_scroll_scaler 1 10` to scroll slower.
 * Direction: remove INPUT_TRANSFORM_Y_INVERT to flip vertical scrolling.
 */
&trackpoint_listener {
    scroller {
        layers = <SCROLL>;
        input-processors = <&zip_xy_to_scroll_mapper>,
                           <&zip_scroll_scaler 1 10>,
                           <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
    };
};
