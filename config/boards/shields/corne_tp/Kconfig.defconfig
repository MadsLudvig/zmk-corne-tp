# Left side is CENTRAL: it connects to the host and drives the nice!view.
# Right side (TrackPoint) is a peripheral and forwards pointer input over the
# split link (see corne_tp.dtsi).
if SHIELD_CORNE_TP_LEFT

config ZMK_KEYBOARD_NAME
    default "Corne TP"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_CORNE_TP_LEFT || SHIELD_CORNE_TP_RIGHT

config ZMK_SPLIT
    default y

endif
